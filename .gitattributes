# Ignore Flutter platform folders in GitHub language stats
android/** linguist-vendored=true
ios/** linguist-vendored=true
web/** linguist-vendored=true
windows/** linguist-vendored=true
macos/** linguist-vendored=true
linux/** linguist-vendored=true

# Ignore build/tool output
build/** linguist-vendored=true
.dart_tool/** linguist-vendored=true
.gradle/** linguist-vendored=true

# Also ignore common non-Dart file types (in case they exist outside those folders)
*.html linguist-vendored=true
*.swift linguist-vendored=true
*.m linguist-vendored=true
*.kt linguist-vendored=true
*.java linguist-vendored=true
*.js linguist-vendored=true
*.css linguist-vendored=true

# Force Dart recognition
*.dart linguist-language=Dart
